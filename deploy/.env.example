# Copy to deploy/.env and fill in. Never commit the real file.
# Generate secrets with: openssl rand -base64 48

# Public hostname (DNS A/AAAA record must point at this server).
DOMAIN=vote.example.com

# --- Required: the API refuses to start in production without these.
POSTGRES_PASSWORD=
SESSION_SECRET=
ELECTRIC_SECRET=
# Signs vote receipts and vote-by-email links.
RECEIPT_SECRET=
VOTE_EMAIL_SECRET=

# --- Email (magic links, verification, notifications). https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Ripple <noreply@vote.example.com>

# --- Billing. https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- Optional integrations
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# --- Optional tuning
# DB_POOL_SIZE=10
# Which proxy hops to trust for client IPs (Express "trust proxy" syntax).
# TRUST_PROXY=loopback, linklocal, uniquelocal
